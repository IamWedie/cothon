<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Cothon.Ui.ViewModels"
        xmlns:controls="clr-namespace:Cothon.Ui.Controls"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
        x:Class="Cothon.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Cothon" Width="720" Height="560" MinWidth="480" MinHeight="400"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        Background="#F5F5F7"
        Foreground="#1D1D1F">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.DataTemplates>
        <!-- You: right, blue bubble -->
        <DataTemplate DataType="{x:Type vm:UserItem}">
            <Border HorizontalAlignment="Right" MaxWidth="440"
                    CornerRadius="18" Padding="12,8"
                    Background="#007AFF" Margin="0,2">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           FontSize="13" Foreground="White" />
            </Border>
        </DataTemplate>

        <!-- Cothon: left, gray bubble -->
        <DataTemplate DataType="{x:Type vm:AssistantItem}">
            <Border HorizontalAlignment="Left" MaxWidth="480"
                    CornerRadius="18" Padding="12,8"
                    Background="#E9E9EB" Margin="0,2">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           FontSize="13" Foreground="#1D1D1F" />
            </Border>
        </DataTemplate>

        <!-- Tool: compact left card with status label -->
        <DataTemplate DataType="{x:Type vm:ToolItem}">
            <Border HorizontalAlignment="Left" MaxWidth="480"
                    CornerRadius="10" Padding="10,7"
                    Background="#FFFFFF" BorderBrush="#E5E5EA"
                    BorderThickness="1" Margin="0,3">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Label}" FontSize="11"
                               Foreground="#86868B" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               FontSize="12" Foreground="#1D1D1F" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- System: centered whisper -->
        <DataTemplate DataType="{x:Type vm:SystemItem}">
            <TextBlock Text="{Binding Text}" FontSize="11"
                       Foreground="#86868B" HorizontalAlignment="Center"
                       Margin="0,2" />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ── Header: mic mirror, never color alone ───────────────── -->
        <Border Grid.Row="0" BorderBrush="#E5E5EA" BorderThickness="0,0,0,1"
                Background="Transparent" Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,1,0,0" Fill="#34C759"
                             IsVisible="{Binding MicOn}" />
                    <Ellipse Width="8" Height="8" Margin="0,1,0,0" Fill="#C7C7CC"
                             IsVisible="{Binding !MicOn}" />
                    <TextBlock Text="Cothon" FontSize="14" FontWeight="SemiBold"
                               Foreground="#1D1D1F" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Presence}" FontSize="12"
                           Foreground="#86868B" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Hero: orb is the app, captions under it ─────────────── -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">

            <Border Tapped="OnOrbTapped" Cursor="Hand"
                    Width="220" Height="220" Background="Transparent"
                    HorizontalAlignment="Center">
                <controls:SiriOrb State="{Binding SessionState}" />
            </Border>

            <TextBlock Text="{Binding UserCaption}" FontSize="12" Foreground="#86868B"
                       TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Center"
                       Margin="0,10,0,0" IsVisible="{Binding HasUserCaption}" />

            <TextBlock Text="{Binding AssistantCaption}" FontSize="22" FontWeight="SemiBold"
                       Foreground="#1D1D1F" TextWrapping="Wrap" MaxWidth="560"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />

            <TextBlock Text="Type below, or tap the orb. Every action is checked and reversible."
                       FontSize="12" Foreground="#86868B" HorizontalAlignment="Center"
                       Margin="0,6,0,0" />
        </StackPanel>

        <!-- ── Input row ───────────────────────────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="20,8,20,0">
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E0E0E3"
                    BorderThickness="1" Margin="0,0,10,0">
                <TextBox Text="{Binding Input, Mode=TwoWay}"
                         PlaceholderText="Message"
                         Background="Transparent" BorderThickness="0"
                         Padding="14,9" FontSize="13" MinHeight="38"
                         KeyDown="OnInputKeyDown" />
            </Border>
            <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}"
                    FontSize="13" FontWeight="SemiBold" Foreground="White"
                    Background="#0071E3" CornerRadius="18" Padding="20,9"
                    VerticalAlignment="Stretch" MinHeight="38" />
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────── -->
        <TextBlock Grid.Row="3" Text="Sandboxed · Policy-gated · Undoable"
                   FontSize="10" Foreground="#A1A1A8"
                   HorizontalAlignment="Center" Margin="0,8,0,12" />
    </Grid>
</Window>
