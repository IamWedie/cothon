<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Cothon.Ui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="680"
        x:Class="Cothon.PairWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Pair your phone" Width="440" Height="680" CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        Background="{DynamicResource C.Surface}" Foreground="{DynamicResource C.Text}">

    <StackPanel Margin="28" Spacing="18">
        <TextBlock Text="Pair your phone with Cothon"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource C.HeaderText}" />

        <StackPanel Spacing="4">
            <TextBlock Text="1. On your phone: Settings → Developer options → Wireless debugging"
                       FontSize="12.5" Foreground="{DynamicResource C.Label}" TextWrapping="Wrap" />
            <TextBlock Text="2. Tap “Pair device with QR code”"
                       FontSize="12.5" Foreground="{DynamicResource C.Label}" TextWrapping="Wrap" />
            <TextBlock Text="3. Point the phone's camera at the code below — it pairs to this PC and Cothon will connect."
                       FontSize="12.5" Foreground="{DynamicResource C.Label}" TextWrapping="Wrap" />
        </StackPanel>

        <Border CornerRadius="16" Padding="24" HorizontalAlignment="Center"
                Background="White">
            <Image Source="{Binding PairQr}" Width="280" Height="280" />
        </Border>

        <TextBlock Text="{Binding PairStatus}"
                   FontSize="12" Foreground="{DynamicResource C.TextDim}"
                   TextWrapping="Wrap" MaxWidth="380" />

        <Button Content="Close" Click="OnClose"
                FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                Foreground="{DynamicResource C.AccentText}"
                Background="{DynamicResource C.Accent}" CornerRadius="14" Padding="20,9" />
    </StackPanel>
</Window>
