<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Cothon.Ui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="680"
        x:Class="Cothon.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Cothon Settings" Width="480" Height="680" MinWidth="420" MinHeight="520"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        Background="#FFFFFF" Foreground="#1D1D1F">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="28,24,28,20">

        <!-- ── Title ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,18">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="#1D1D1F" />
            <TextBlock Text="Saved preferences apply on next launch."
                       FontSize="12" Foreground="#86868B" />
        </StackPanel>

        <!-- ── Form ────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="22">

                <!-- Account -->
                <StackPanel Spacing="10">
                    <TextBlock Text="ACCOUNT" FontSize="11" FontWeight="SemiBold"
                               Foreground="#86868B" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Model provider" FontSize="12" Foreground="#3C3C43" />
                        <ComboBox ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding Provider}"
                                  MinHeight="38" CornerRadius="10" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Gemini API key" FontSize="12" Foreground="#3C3C43" />
                        <TextBox Text="{Binding GeminiApiKey, Mode=TwoWay}"
                                 PlaceholderText="paste key (stays on this machine)"
                                 PasswordChar="•" MinHeight="40" FontSize="13"
                                 CornerRadius="10" Background="#F5F5F7" BorderBrush="#E5E5EA" />
                    </StackPanel>
                </StackPanel>

                <!-- Phone -->
                <StackPanel Spacing="10">
                    <TextBlock Text="PHONE" FontSize="11" FontWeight="SemiBold"
                               Foreground="#86868B" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4" Grid.IsSharedSizeScope="False">
                            <TextBlock Text="Phone address (host:port over Wi-Fi)" FontSize="12" Foreground="#3C3C43" />
                            <Grid ColumnDefinitions="*,90">
                                <TextBox Text="{Binding PhoneHost, Mode=TwoWay}"
                                         PlaceholderText="192.168.1.20" MinHeight="40" FontSize="13"
                                         CornerRadius="10" Background="#F5F5F7" BorderBrush="#E5E5EA" />
                                <TextBox Grid.Column="1" Text="{Binding PhonePort, Mode=TwoWay}"
                                         PlaceholderText="Port" MinHeight="40" FontSize="13" Margin="8,0,0,0"
                                         CornerRadius="10" Background="#F5F5F7" BorderBrush="#E5E5EA" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="adb path (leave empty to auto-probe)" FontSize="12" Foreground="#3C3C43" />
                        <TextBox Text="{Binding AdbPath, Mode=TwoWay}"
                                 PlaceholderText="C:\platform-tools\adb.exe" MinHeight="40" FontSize="13"
                                 CornerRadius="10" Background="#F5F5F7" BorderBrush="#E5E5EA" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Probe adb" Command="{Binding ProbeAdbCommand}"
                                FontSize="12" Foreground="#0071E3" Background="#F5F5F7"
                                CornerRadius="12" Padding="14,7" />
                        <Button Content="Test connection" Command="{Binding TestPhoneCommand}"
                                FontSize="12" FontWeight="SemiBold" Foreground="White"
                                Background="#0071E3" CornerRadius="12" Padding="14,7" />
                    </StackPanel>
                </StackPanel>

                <!-- Privacy -->
                <StackPanel Spacing="10">
                    <TextBlock Text="PRIVACY" FontSize="11" FontWeight="SemiBold"
                               Foreground="#86868B" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Remember facts in memory" FontSize="12" Foreground="#3C3C43" />
                            <TextBlock Text="Kept locally, secrets redacted." FontSize="11" Foreground="#86868B" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MemoryLogging}"
                                      HorizontalAlignment="Right" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Read my screen" FontSize="12" Foreground="#3C3C43" />
                            <TextBlock Text="One capture per message, marked in the conversation." FontSize="11" Foreground="#86868B" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScreenCapture}"
                                      HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- General -->
                <StackPanel Spacing="10">
                    <TextBlock Text="GENERAL" FontSize="11" FontWeight="SemiBold"
                               Foreground="#86868B" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Mic hotkey (global)" FontSize="12" Foreground="#3C3C43" />
                        <TextBox Text="{Binding Hotkey, Mode=TwoWay}"
                                 PlaceholderText="Ctrl+Alt+Space" MinHeight="40" FontSize="13"
                                 CornerRadius="10" Background="#F5F5F7" BorderBrush="#E5E5EA" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Bottom bar ──────────────────────────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#86868B"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Save" Command="{Binding SaveCommand}"
                    FontSize="13" FontWeight="SemiBold" Foreground="White"
                    Background="#0071E3" CornerRadius="14" Padding="20,9" />
        </Grid>
    </Grid>
</Window>
